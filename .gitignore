# macOS
.DS_Store

# Xcode user-specific state (per-machine, shouldn't be shared)
**/xcuserdata/
**/*.xcuserstate

# Build outputs
DerivedData/
build/

# Release artifacts — generated by scripts/release.sh + scripts/notarize.sh.
# Regenerate on demand; do not track binary shipping artifacts in git.
dist/

# Derived doc outputs (regenerate via scripts/md_to_pdf.py)
*.html
*.pdf
